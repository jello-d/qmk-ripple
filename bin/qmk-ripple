#!/usr/bin/env python3
# Copyright 2026 jello-d
# SPDX-License-Identifier: Apache-2.0
"""qmk-ripple -- routine control of the ripple keyboard backlight.

The HOT PATH: panel-power runs this on every screen blank and unblank, so it
stays small, dependency-free, and NEVER needs root (the udev rule installed by
`qmk-ripple-admin install` grants the session user the hidraw node).

    qmk-ripple off   LEDs dark (transient; see below)
    qmk-ripple on    LEDs back

That is the WHOLE surface, and deliberately so. Setup, flashing, auditing --
and the bootloader jump -- live in a separate command, qmk-ripple-admin.

The jump is not here even though it is the same 1-byte protocol and needs no
root, because it is a flashing operation rather than routine control, and it
is the one byte with teeth: ripple's 0x03 is VIA's id_set_keyboard_value, a
WRITE, so on a board that is not running ripple it does not fail cleanly, it
changes something. The command that runs on every blank should not be able to
do that. (qmk-ripple-admin reaches the protocol through lib/, not through this
command, so nothing is lost.)

"off" is transient: it lives in the MCU's RAM (rgb_matrix_disable_noeeprom),
and the firmware wipes it on any fresh USB enumeration, so a reboot or replug
always comes back lit even if this command never gets to send "on".

Exit: 0 ok; 2 keyboard not found (so panel-power treats "no keyboard" as a
harmless no-op); 1 other error.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
try:
    import qmkripple as qr
except ImportError:
    sys.stderr.write(
        "qmk-ripple: cannot import lib/qmkripple.py -- the package layout is\n"
        "broken. bin/ and lib/ must stay siblings in the checkout.\n")
    sys.exit(1)


EPILOG = """\
first flash
-----------
%s

why 0xFF60 is not proof
-----------------------
%s
""" % (qr.FIRST_FLASH_NOTE, qr.USAGE_PAGE_WARNING)


def main():
    ap = argparse.ArgumentParser(
        prog="qmk-ripple",
        description="Control the ripple keyboard backlight (no root needed).",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    # NOT list(qr.CMDS): that is the wire protocol, which includes the
    # bootloader jump. This command exposes only the two safe, routine verbs.
    ap.add_argument("cmd", choices=["off", "on"],
                    help="off: LEDs dark; on: LEDs back. "
                         "(the bootloader jump is `qmk-ripple-admin "
                         "bootloader`)")
    ap.add_argument("--vid", default="%04x" % qr.VID)
    ap.add_argument("--pid", default="%04x" % qr.PID)
    a = ap.parse_args()

    try:
        qr.send(a.cmd, int(a.vid, 16), int(a.pid, 16))
    except qr.NotFound as e:
        sys.stderr.write("qmk-ripple: %s\n" % e)
        sys.stderr.write("  If this board still has stock firmware, that is "
                         "expected: run\n  `qmk-ripple-admin check` for the "
                         "diagnosis and the first-flash path.\n")
        return 2
    except qr.Error as e:
        sys.stderr.write("qmk-ripple: %s\n" % e)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

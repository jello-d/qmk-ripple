#!/usr/bin/env python3
"""kbd-rgb -- host control of the ripple firmware's RGB backlight over raw HID.

Talks the 1-byte command protocol in qmk/hostctl.c to the keyboard's 0xFF60
raw-HID interface:
    off         0x01  disable the matrix (LEDs dark; transient, noeeprom)
    on          0x02  re-enable the matrix
    bootloader  0x03  jump to the flasher (so a reflash needs no reset pin)

Usage: kbd-rgb {off|on|bootloader} [--vid 359b] [--pid 0010]

Finds the raw-HID node by scanning /sys/class/hidraw (matching the VID/PID and
the 0xFF60 usage page in the report descriptor), then writes the report to
/dev/hidrawN directly -- no hidapi, because its Linux backend reports usage_page
as 0 here. Needs write access to that node (a udev uaccess rule, see
host/60-ripple-kbd.rules). Exit 0 on success, 2 if the keyboard is not found
(so panel-power treats "no keyboard" as a harmless no-op), 1 on a write error.
"""
import argparse
import glob
import os
import sys

REPORT_LEN = 32  # QMK RAW_EPSIZE
# usage page 0xFF60 in a report descriptor: 06 60 FF (Usage Page, 2-byte 0xFF60)
FF60 = bytes((0x06, 0x60, 0xFF))
CMDS = {"off": 0x01, "on": 0x02, "bootloader": 0x03}


def uevent(path):
    d = {}
    try:
        with open(path) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                d[k] = v
    except OSError:
        pass
    return d


def find_node(vid, pid):
    """Return /dev/hidrawN for the raw-HID (0xFF60) interface of vid:pid."""
    want = "%04X:%08X:%08X" % (0x0003, vid, pid)  # bus:vid:pid in HID_ID
    for sysdir in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        dev = os.path.join(sysdir, "device")
        hid_id = uevent(os.path.join(dev, "uevent")).get("HID_ID", "")
        if hid_id.upper() != want:
            continue
        try:
            with open(os.path.join(dev, "report_descriptor"), "rb") as f:
                rd = f.read()
        except OSError:
            continue
        if FF60 in rd:
            return "/dev/" + os.path.basename(sysdir)
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=CMDS)
    ap.add_argument("--vid", default="359b")
    ap.add_argument("--pid", default="0010")
    a = ap.parse_args()
    vid, pid = int(a.vid, 16), int(a.pid, 16)

    node = find_node(vid, pid)
    if node is None:
        sys.stderr.write("kbd-rgb: ripple keyboard not found (raw-HID iface)\n")
        return 2

    # hidraw write: leading report-id byte (0x00 = unnumbered), then the
    # REPORT_LEN payload whose first byte is the command.
    report = bytes([0x00, CMDS[a.cmd]] + [0] * (REPORT_LEN - 1))
    try:
        fd = os.open(node, os.O_WRONLY)
        try:
            os.write(fd, report)
        finally:
            os.close(fd)
    except OSError as e:
        sys.stderr.write("kbd-rgb: %s: %s\n" % (node, e))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
